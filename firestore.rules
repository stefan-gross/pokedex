rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // IDOR-Härtung: Nutzer-Dokumente gehören genau einer uid (`ownerUid`).
    // Lesen/Ändern/Löschen nur für den Besitzer; beim Anlegen muss ownerUid die
    // eigene uid sein. Queries MÜSSEN nach ownerUid filtern (siehe lib/firestore/*),
    // sonst lehnt Firestore die List-Query komplett ab. Bestand ist per
    // /api/admin/backfill-owner gestempelt.
    function signedIn() { return request.auth != null; }
    function owns(res)  { return signedIn() && res.data.ownerUid == request.auth.uid; }
    function createsOwn() { return signedIn() && request.resource.data.ownerUid == request.auth.uid; }

    match /cards/{id} {
      allow read, update, delete: if owns(resource);
      allow create: if createsOwn();
    }
    // Preis-Historie (Unter-Collection): an den Besitz der Elternkarte gebunden.
    match /cards/{cardId}/priceHistory/{id} {
      allow read, write: if signedIn()
        && get(/databases/$(database)/documents/cards/$(cardId)).data.ownerUid == request.auth.uid;
    }
    match /binders/{id} {
      allow read, update, delete: if owns(resource);
      allow create: if createsOwn();
    }
    match /wishlists/{id} {
      allow read, update, delete: if owns(resource);
      allow create: if createsOwn();
    }

    // Scan-Telemetrie (Optimierung/Fehleranalyse): kompakte Events je Scan,
    // volle Fälle (mit Bild) bei Fehlern/Meldungen, sowie ein Live-Aggregat pro
    // Nutzer. Alles owner-gescopt; Queries filtern nach ownerUid.
    match /scan_events/{id} {
      allow read, update, delete: if owns(resource);
      allow create: if createsOwn();
    }
    match /scan_cases/{id} {
      allow read, update, delete: if owns(resource);
      allow create: if createsOwn();
    }
    // scan_stats: Doc-ID == uid; Zugriff wenn ownerUid == uid (Create wie Update
    // schreibt ownerUid mit → createsOwn deckt beide via write ab).
    match /scan_stats/{uid} {
      allow read, delete: if owns(resource);
      allow write: if createsOwn();
    }

    // Pokémon-Kartenkatalog — öffentliche Daten, kein Auth nötig
    // Schreibzugriff nur vom Server (geschützt durch API-Route + Session)
    // Öffentlich lesbar; Schreibzugriff NUR serverseitig (Admin-SDK umgeht
    // Rules). Vorher `write: if true` → jeder Browser konnte den Katalog
    // überschreiben/löschen.
    match /tcg_catalog/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /tcg_catalog_meta/{id} {
      allow read: if true;
      allow write: if false;
    }
    // Set-Metadaten (Name DE, Logo, Kürzel, Totals) — öffentliche Katalogdaten.
    // Client liest sie u.a. im Dashboard (getSetById) und Kartendetail; ohne
    // diese Regel greift Default-Deny und der Client-Read schlägt still fehl
    // (Dashboard zeigte dann EN-Namen + keine Logos). Schreibzugriff erfolgt
    // ausschließlich serverseitig über das Admin-SDK (umgeht Rules).
    match /tcg_sets/{id} {
      allow read: if true;
      allow write: if false;
    }
  }
}
